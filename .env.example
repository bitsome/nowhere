APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_CONVERSIONS_DISK=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ORDER_AI_API_KEY=
ORDER_AI_BASE_URL=https://api.openai.com/v1
ORDER_AI_MODEL=gpt-4.1-mini
ORDER_AI_TIMEOUT=20
ORDER_AI_VERIFY_SSL=true

# 정산·수금 — 플랫폼 수수료율(비율)·최소 수수료(원)·등록자 대금 매입 계좌
# SETTLEMENT_FEE_RATE=0.05
# SETTLEMENT_MIN_FEE=0
# SETTLEMENT_AUTO_AFTER_HOURS=24
# SETTLEMENT_PLATFORM_BANK_NAME=
# SETTLEMENT_PLATFORM_ACCOUNT_NUMBER=
# SETTLEMENT_PLATFORM_ACCOUNT_HOLDER=

VITE_APP_NAME="${APP_NAME}"

# 프론트엔드 빌드용 — SPA의 OG·canonical 절대 주소를 채운다(위챗·카카오 미리보기 카드).
# 도메인 확정 후: VITE_SITE_URL=https://example.com npm run build (frontend/)
# 미설정이면 종전처럼 상대 경로로 빌드된다.
# VITE_SITE_URL=
